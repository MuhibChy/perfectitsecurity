APP_NAME=TechSupport
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000
TRUSTED_PROXIES=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
# Production MySQL (set DB_CONNECTION=mysql + these when deploying):
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=techsupport
# DB_USERNAME=
# DB_PASSWORD=
# MYSQL_ATTR_SSL_CA=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Optional AI integration. Leave empty to run without an API-backed assistant.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# Ollama (local LLM via MCP — optional; used when AI_PROVIDER=ollama or for KB-generation tasks):
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma2:27b
OLLAMA_API_TOKEN=
OLLAMA_TIMEOUT=30

# Payments (Stripe — manual offline payments work without these; online checkout needs them):
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Phone OTP (Twilio Verify — local OTP fallback works without these):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Backups (dedicated key — generate via: php -r "echo base64_encode(random_bytes(32));")
BACKUP_ENABLED=true
BACKUP_SCHEDULE_FULL="0 2 * * *"
BACKUP_SCHEDULE_DB="0 */6 * * *"
BACKUP_SCHEDULE_FILES="0 2 * * *"
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=12
BACKUP_DISK=local
BACKUP_DIRECTORY=backups
BACKUP_MAX_BYTES=2147483648
BACKUP_TIMEOUT_SECONDS=1800
BACKUP_RETRIES=2
BACKUP_KEEP_PRE_DEPLOY=true
BACKUP_ENCRYPTION_ENABLED=true
BACKUP_ENCRYPTION_CIPHER=AES-256-CBC
BACKUP_ENCRYPTION_KEY=
BACKUP_S3_ENABLED=false
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_PREFIX=techsupport-backups
BACKUP_NOTIFY_EMAIL=
BACKUP_NOTIFY_ON_SUCCESS=false
BACKUP_NOTIFY_ON_FAILURE=true
BACKUP_ALLOW_PRODUCTION_RESTORE=false

# Push notifications (Firebase — optional, leave empty if unused):
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=

# --- PRODUCTION CHECKLIST (copy to .env on the server, never commit secrets) ---
# APP_ENV=production
# APP_DEBUG=false  (never true in production — leaks stack traces)
# APP_URL=https://your-domain.com
# CORS_ALLOWED_ORIGINS=https://your-domain.com
# TRUSTED_PROXIES=*  (behind nginx/LB TLS terminator)
# LOG_LEVEL=warning
# DB_CONNECTION=mysql (+ DB_HOST/PORT/DATABASE/USERNAME/PASSWORD above)
# CACHE_DRIVER=redis + REDIS_HOST/PASSWORD/PORT
# QUEUE_CONNECTION=redis (+ supervisor queue:work)
# SESSION_DRIVER=database + SESSION_SECURE_COOKIE=true
# MAIL_MAILER=smtp (+ MAIL_HOST/PORT/USERNAME/PASSWORD/ENCRYPTION/MAIL_FROM_*)
# Rotate APP_KEY + AI_API_KEY via secret store; never reuse the local/dev keys.
