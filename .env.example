APP_NAME=PerfectITSecurity
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000
TRUSTED_PROXIES=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
# Production MySQL (set DB_CONNECTION=mysql + these when deploying):
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=techsupport
# DB_USERNAME=
# DB_PASSWORD=
# MYSQL_ATTR_SSL_CA=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Display-only fallback timezone for per-user rendering (storage is always UTC).
DISPLAY_TIMEZONE=UTC

# ── PRODUCTION OVERRIDES (set on the server; NEVER copy a local .env) ──
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://<real-domain>
# SESSION_SECURE_COOKIE=true
# SESSION_DRIVER=database
# CACHE_DRIVER=redis
# QUEUE_CONNECTION=redis
# LOG_LEVEL=warning
# TRUSTED_PROXIES=<lb-or-cdn-ips> (see TrustProxies; '*' only if the host has no direct clients)

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Optional AI integration. Leave empty to run without an API-backed assistant.
AI_PROVIDER=ollama
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# OpenRouter (cloud models via OpenAI-compatible API; AI_PROVIDER=openrouter).
# Key lives ONLY in .env (gitignored) — never in docs, tests, or logs.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT=60

# Local-first policy (AgentGateway chat only): Ollama is primary. A cloud
# provider is contacted ONLY when AI_FALLBACK_ENABLED=true AND
# AI_FALLBACK_PROVIDER names the approved provider — at most ONE attempt,
# then a safe error with human escalation. A stored API key alone never
# triggers cloud use. Keep disabled unless cloud fallback is approved.
# HTTP 402 (billing/quota) is an eligible fallback trigger when enabled.
AI_FALLBACK_ENABLED=false
AI_FALLBACK_PROVIDER=
AI_MAX_ATTEMPTS_PER_PROVIDER=1
AI_MAX_PROMPT_CHARS=8000
AI_LOG_PROMPT_CONTENT=false

# Ollama (local LLM — primary provider when AI_PROVIDER=ollama).
# Keep the loopback URL for local dev; production needs a private AI endpoint
# (never expose Ollama's port to the public Internet — see docs/AI_AGENT.md).
# OLLAMA_MODEL must name a model installed on the server (GET /api/tags).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_MODEL_FAST=llama3.2:latest
OLLAMA_MODEL_STRONG=qwen2.5-coder:14b
OLLAMA_API_TOKEN=
OLLAMA_TIMEOUT=120
OLLAMA_CONNECT_TIMEOUT=10
OLLAMA_KEEP_ALIVE=30m

# Payments (Stripe — manual offline payments work without these; online checkout needs them):
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Flexible multi-provider payments (all secrets env-only, never in DB plaintext/logs).
# General (admin UI: Settings -> Payments mirrors these defaults):
PAYMENT_DEFAULT_CURRENCY=BDT
PAYMENT_SUPPORTED_CURRENCIES=BDT,GBP,USD,EUR
PAYMENT_TIMEOUT_SECONDS=900
INVOICE_PAYMENT_DEADLINE_DAYS=14

# bKash tokenized checkout (official merchant credentials, per environment):
BKASH_TEST_APP_KEY=
BKASH_TEST_APP_SECRET=
BKASH_TEST_USERNAME=
BKASH_TEST_PASSWORD=
BKASH_TEST_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_TEST_WEBHOOK_SECRET=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=https://tokenized.pay.bka.sh/v1.2.0-beta
BKASH_WEBHOOK_SECRET=

# Nagad merchant credentials (as supplied by Nagad):
NAGAD_TEST_MERCHANT_ID=
NAGAD_TEST_MERCHANT_KEY=
NAGAD_TEST_BASE_URL=
NAGAD_TEST_WEBHOOK_SECRET=
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_KEY=
NAGAD_BASE_URL=
NAGAD_WEBHOOK_SECRET=

# Rocket/DBBL merchant credentials (as supplied by the bank/gateway):
ROCKET_TEST_MERCHANT_ID=
ROCKET_TEST_ACCOUNT_ID=
ROCKET_TEST_API_KEY=
ROCKET_TEST_BASE_URL=
ROCKET_TEST_WEBHOOK_SECRET=
ROCKET_MERCHANT_ID=
ROCKET_ACCOUNT_ID=
ROCKET_API_KEY=
ROCKET_BASE_URL=
ROCKET_WEBHOOK_SECRET=

# PayPal / generic international gateway (configure whichever entity is eligible):
PAYPAL_TEST_CLIENT_ID=
PAYPAL_TEST_CLIENT_SECRET=
PAYPAL_TEST_WEBHOOK_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
INTL_GATEWAY_TEST_MERCHANT_ID=
INTL_GATEWAY_TEST_API_KEY=
INTL_GATEWAY_TEST_API_SECRET=
INTL_GATEWAY_TEST_BASE_URL=
INTL_GATEWAY_TEST_WEBHOOK_SECRET=
INTL_GATEWAY_MERCHANT_ID=
INTL_GATEWAY_API_KEY=
INTL_GATEWAY_API_SECRET=
INTL_GATEWAY_BASE_URL=
INTL_GATEWAY_WEBHOOK_SECRET=

# Phone OTP (Twilio Verify — local OTP fallback works without these):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Backups (dedicated key — generate via: php -r "echo base64_encode(random_bytes(32));")
BACKUP_ENABLED=true
BACKUP_SCHEDULE_FULL="0 2 * * *"
BACKUP_SCHEDULE_DB="0 */6 * * *"
BACKUP_SCHEDULE_FILES="0 2 * * *"
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=12
BACKUP_DISK=local
BACKUP_DIRECTORY=backups
BACKUP_MAX_BYTES=2147483648
BACKUP_ENCRYPTION_ENABLED=true
BACKUP_ENCRYPTION_CIPHER=AES-256-CBC
BACKUP_ENCRYPTION_KEY=
BACKUP_S3_ENABLED=false
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_PREFIX=techsupport-backups
BACKUP_NOTIFY_EMAIL=
BACKUP_ALLOW_PRODUCTION_RESTORE=false

# AI Agent Gateway (thin adapter; external runtimes OFF until staging-verified).
# AI_AGENT_RUNTIME=none|hermes|openclaw. Never enable Hermes/OpenClaw in prod
# until health/capabilities/tool/approval/sandbox evidence exists.
AI_AGENT_ENABLED=false
AI_AGENT_RUNTIME=none
AI_AGENT_ENDPOINT=
AI_AGENT_TIMEOUT=60
AI_AGENT_CONNECT_TIMEOUT=10
AI_CHAT_ENABLED=true
HERMES_ENABLED=false
OPENCLAW_ENABLED=false
OMNIROUTE_ENABLED=false
AI_AGENT_MAX_TOKENS=512
AI_AGENT_MAX_CONCURRENCY=4
AI_AGENT_REQUIRE_APPROVAL=true
AI_AGENT_ALLOWED_TOOLS=search_knowledge_base,search_services,get_customer_tickets,get_ticket_status,get_order_status,get_project_status,get_customer_invoice_status,get_authenticated_user,get_customer_profile,create_support_ticket,add_ticket_message,create_service_request,escalate_to_employee,get_assigned_tickets,get_assigned_tasks,generate_service_report,create_work_log,summarize_customer_issues
AI_AGENT_ALLOWED_ROLES=customer,support_agent,project_manager,finance_manager,employee,freelancer,admin,super_admin,support_manager,sales_agent,training_manager,commission_agent

# --- PRODUCTION CHECKLIST (copy to .env on the server, never commit secrets) ---
# APP_ENV=production
# APP_DEBUG=false  (never true in production — leaks stack traces)
# APP_URL=https://your-domain.com
# CORS_ALLOWED_ORIGINS=https://your-domain.com
# TRUSTED_PROXIES=*  (behind nginx/LB TLS terminator)
# LOG_LEVEL=warning
# DB_CONNECTION=mysql (+ DB_HOST/PORT/DATABASE/USERNAME/PASSWORD above)
# CACHE_DRIVER=redis + REDIS_HOST/PASSWORD/PORT
# QUEUE_CONNECTION=redis (+ supervisor queue:work)
# SESSION_DRIVER=database + SESSION_SECURE_COOKIE=true
# MAIL_MAILER=smtp (+ MAIL_HOST/PORT/USERNAME/PASSWORD/ENCRYPTION/MAIL_FROM_*)
# Rotate APP_KEY + AI_API_KEY via secret store; never reuse the local/dev keys.
