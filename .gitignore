# Dependencies
/vendor/
/node_modules/

# Environment configurations & local secrets
/.env
/.env.*
!.env.example
user and password for testing.txt
*credentials*.txt
*password*.txt

# Local SQLite databases
*.sqlite
*.sqlite*
/database/*.sqlite
/database/*.sqlite*
/database/*.sqlite.bak

# Backups & dumps (never commit archives or local backups)
/backups/
/storage/backups/
/storage/app/backups/
/storage/app/safety-checkpoints/
*.sql
*.dump
*.bak
*.backup
*.zip

# Keys and certificates
*.key
*.pem
/storage/*.key
Homestead.json
Homestead.yaml
auth.json

# Storage and logs
/storage/logs/*
!/storage/logs/.gitignore
!/storage/logs/.gitkeep
/storage/framework/cache/*
!/storage/framework/cache/.gitignore
!/storage/framework/cache/.gitkeep
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore
!/storage/framework/cache/data/.gitkeep
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
!/storage/framework/sessions/.gitkeep
/storage/framework/views/*
!/storage/framework/views/.gitignore
!/storage/framework/views/.gitkeep
/storage/app/private/
/storage/app/public/*
!/storage/app/public/.gitkeep
/storage/app/documents/*
!/storage/app/documents/.gitkeep
/storage/app/ticket-attachments/*
!/storage/app/ticket-attachments/.gitkeep
/storage/app/avatars/*
!/storage/app/avatars/.gitkeep
/storage/app/*.json
/storage/app/*.txt
/storage/audit_ui.php
*.log

# Bootstrap cache
/bootstrap/cache/*.php
!/bootstrap/cache/.gitignore

# Public generated assets
/public/build
/public/hot
/public/storage
/dist/

# Testing, coverage, and caches
.phpunit.result.cache
/.phpunit.cache/
/coverage/
/playwright-report/
/test-results/
/playwright/.cache/
/tests/browser/artifacts/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor and OS files
/.fleet
/.idea
/.vscode
.DS_Store
Thumbs.db

# Local AI / IDE agent temporary folders
.commandcode/
.freebuff/
.kilo/
.kilocode/
.opencode/
